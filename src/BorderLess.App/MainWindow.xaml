<Window x:Class="BorderLess.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BorderLess.App" Style="{StaticResource {x:Type Window}}" Title="BorderLess" Icon="Assets/BorderLess.ico" Width="1180" Height="820" MinWidth="940" MinHeight="680" WindowStartupLocation="CenterScreen" SourceInitialized="WindowReady" Closing="WindowClosing">
  <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="212"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
      <Grid Margin="20,28,20,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><StackPanel Orientation="Horizontal" Margin="8,0,0,32"><Border Width="30" Height="30" Background="{DynamicResource AccentBrush}" CornerRadius="7" Margin="0,0,10,0"><Grid><Rectangle Width="12" Height="10" Stroke="White" StrokeThickness="1.5" Margin="-7,-5,0,0"/><Rectangle Width="12" Height="10" Stroke="White" StrokeThickness="1.5" Margin="7,5,0,0"/></Grid></Border><TextBlock Text="{local:Tr 'BorderLess'}" FontWeight="SemiBold" FontSize="20" VerticalAlignment="Center"/></StackPanel>
          <Button x:Name="DevicesNav" Style="{StaticResource NavButton}" Content="{local:Tr 'Equipos'}" Tag="devices" Click="Navigate" Background="{DynamicResource SoftBrush}" Foreground="{DynamicResource AccentTextBrush}"/>
          <Button x:Name="FilesNav" Style="{StaticResource NavButton}" Content="{local:Tr 'Archivos'}" Tag="files" Click="Navigate"/>
          <Button x:Name="SettingsNav" Style="{StaticResource NavButton}" Content="{local:Tr 'Preferencias'}" Tag="settings" Click="Navigate"/>
          <Button x:Name="ActivityNav" Style="{StaticResource NavButton}" Content="{local:Tr 'Actividad'}" Tag="activity" Click="Navigate"/>
        </StackPanel>
        <StackPanel Grid.Row="2"><Border Background="{DynamicResource CanvasBrush}" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="{local:Tr 'Volver a este equipo'}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{local:Tr 'Ctrl + Alt + F12'}" FontWeight="SemiBold" Margin="0,5,0,0"/></StackPanel></Border><TextBlock Text="{local:Tr '0.1.10 · Windows'}" Style="{StaticResource Caption}" Margin="12,16,0,0"/></StackPanel>
      </Grid>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <ScrollViewer x:Name="MainScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid Margin="36,28,36,24">
        <StackPanel x:Name="DevicesPage">
          <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Tr 'Tu espacio, conectado'}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{local:Tr 'Un mouse y un teclado para tus equipos.'}" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="1" Content="{local:Tr 'Añadir equipo'}" Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Click="OpenPairing" AutomationProperties.Name="{local:Tr 'Añadir equipo'}"/></Grid>
          <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Tr 'ESTE EQUIPO'}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/><TextBlock x:Name="LocalName" FontSize="21" FontWeight="SemiBold" Margin="0,6,0,3"/><TextBlock x:Name="LocalMachineName" Style="{StaticResource Caption}"/><TextBlock x:Name="LocalAddress" Style="{StaticResource Caption}"/><TextBlock x:Name="ListeningStatus" Text="{local:Tr 'Iniciando recepción…'}" Foreground="{DynamicResource AccentTextBrush}" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="1" Content="{local:Tr 'Editar alias'}" Click="RenameLocal" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid></Border>
          <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,20"><StackPanel><TextBlock Text="{local:Tr 'Equipos y pantallas'}" Style="{StaticResource SectionTitle}"/><local:TopologyMap x:Name="LayoutMap"/></StackPanel></Border>
          <Grid Margin="0,0,0,12"><TextBlock Text="{local:Tr 'Equipos vinculados'}" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="PeerCount" Text="{local:Tr '0 equipos'}" HorizontalAlignment="Right" Style="{StaticResource Caption}"/></Grid>
          <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="32"><StackPanel HorizontalAlignment="Center" MaxWidth="450"><TextBlock Text="{local:Tr 'Tu siguiente equipo empieza aquí'}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/><TextBlock Text="{local:Tr 'Abre BorderLess en el otro PC. Genera allí un código de 8 dígitos y escríbelo aquí para vincularlos.'}" Style="{StaticResource Caption}" TextAlignment="Center" Margin="0,12,0,20"/><Button Content="{local:Tr 'Vincular mi primer equipo'}" HorizontalAlignment="Center" Click="OpenPairing"/></StackPanel></Border>
          <ItemsControl x:Name="PeerList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding Name}" Style="{StaticResource Caption}" Margin="0,3,0,0"/><TextBlock Text="{local:LiveText Path=Status}" Foreground="{Binding StatusColor}" Margin="0,6,0,0"/><TextBlock Text="{local:LiveText Path=Detail}" Style="{StaticResource Caption}" Margin="0,4,0,12"/><StackPanel Orientation="Horizontal"><TextBlock Text="{local:Tr 'Cruzar desde el borde'}" VerticalAlignment="Center" Margin="0,0,12,0" Style="{StaticResource Caption}"/><ComboBox SelectedValue="{Binding Edge, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Width="135" AutomationProperties.Name="{local:Tr 'Borde de acceso al equipo'}"><ComboBoxItem Content="{local:Tr 'Sin borde'}" Tag="none"/><ComboBoxItem Content="{local:Tr 'Izquierdo'}" Tag="left"/><ComboBoxItem Content="{local:Tr 'Derecho'}" Tag="right"/><ComboBoxItem Content="{local:Tr 'Superior'}" Tag="top"/><ComboBoxItem Content="{local:Tr 'Inferior'}" Tag="bottom"/></ComboBox></StackPanel></StackPanel><StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"><Button Content="{local:Tr 'Controlar'}" Style="{StaticResource PrimaryButton}" Tag="{Binding Id}" IsEnabled="{Binding Online}" Click="ControlPeer" Margin="0,0,0,8"/><Button Content="{local:Tr 'Editar alias'}" Tag="{Binding Id}" Click="RenamePeer" Padding="12,6" FontSize="12" Margin="0,0,0,6"/><Button Content="{local:Tr 'Desvincular'}" Tag="{Binding Id}" Click="ForgetPeer" Padding="12,6" FontSize="12" ToolTip="{local:Tr 'Revocar acceso de este equipo'}"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <Border Background="{DynamicResource SoftBrush}" CornerRadius="8" Padding="16" Margin="0,20,0,0"><TextBlock Text="{local:Tr 'Asigna un borde a cada equipo o pulsa Controlar. Mantén el cursor en ese borde un instante para cruzar. Ctrl + Alt + F12 siempre devuelve el control local.'}" Foreground="{DynamicResource SoftTextBrush}" FontSize="13" LineHeight="21"/></Border>
          <Border Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Tr 'Portapapeles compartido'}" FontWeight="SemiBold"/><TextBlock x:Name="ClipboardStatus" Text="{local:Tr 'Listo para compartir texto e imágenes'}" Style="{StaticResource Caption}" Margin="0,6,12,0"/></StackPanel><Button Grid.Column="1" Content="{local:Tr 'Compartir ahora'}" Click="ShareClipboard" VerticalAlignment="Center" ToolTip="{local:Tr 'Enviar el texto o la imagen actual a los equipos conectados'}"/></Grid></Border>
        </StackPanel>
        <StackPanel x:Name="FilesPage" Visibility="Collapsed">
          <TextBlock Text="{local:Tr 'Archivos entre tus equipos'}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{local:Tr 'Elige qué enviar. El otro equipo decide si lo recibe.'}" Style="{StaticResource Caption}" Margin="0,8,0,24"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><CheckBox x:Name="AllowFiles" Content="{local:Tr 'Habilitar envío y recepción de archivos'}" Checked="FilesPreferenceChanged" Unchecked="FilesPreferenceChanged" FontWeight="SemiBold"/><TextBlock x:Name="FilesStatus" Style="{StaticResource Caption}" Margin="32,4,0,0"/><TextBlock Text="{local:Tr 'Activa esta opción en ambos PCs. Deshabilitarla o pausar BorderLess cancela las transferencias en curso.'}" Style="{StaticResource Caption}" Margin="0,14,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{local:Tr 'Enviar un archivo'}" Style="{StaticResource SectionTitle}"/><Label Content="{local:Tr 'Equipo de destino'}" Target="{Binding ElementName=FileRecipient}" Padding="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="FileRecipient" DisplayMemberPath="Label" SelectionChanged="FileRecipientChanged" AutomationProperties.Name="{local:Tr 'Equipo de destino para el archivo'}"/><Button Grid.Column="1" x:Name="SendFileButton" Content="{local:Tr 'Elegir archivo y enviar'}" Style="{StaticResource PrimaryButton}" Click="SendFile" Margin="12,0,0,0" IsEnabled="False"/></Grid><TextBlock Text="{local:Tr 'Un envío a la vez · hasta 1 GiB por archivo · velocidad limitada a aproximadamente 1 MiB/s para dejar margen a la entrada.'}" Style="{StaticResource Caption}" Margin="0,12,0,0"/><TextBlock x:Name="FileFeedback" Foreground="{DynamicResource ErrorBrush}" Margin="0,8,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Padding="20" Margin="0,0,0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Tr 'Carpeta de recepción'}" FontWeight="SemiBold"/><TextBlock x:Name="ReceiveFolder" Style="{StaticResource Caption}" Margin="0,6,12,0"/><TextBlock x:Name="ReceiveFolderFeedback" Style="{StaticResource Caption}" Margin="0,6,12,0"/><TextBlock Text="{local:Tr 'Cada archivo se guarda en su propia subcarpeta, sin sobrescribir archivos existentes. No se abre automáticamente. Cambiar carpeta afecta a nuevas recepciones; los archivos existentes no se mueven.'}" Style="{StaticResource Caption}" Margin="0,6,12,0"/></StackPanel><StackPanel x:Name="ReceiveFolderActions" Grid.Column="1" VerticalAlignment="Center"><Button Content="{local:Tr 'Cambiar carpeta'}" Click="ChooseReceiveFolder" Margin="0,0,0,8"/><Button Content="{local:Tr 'Abrir carpeta'}" Click="OpenReceiveFolder" Margin="0,0,0,8"/><Button Content="{local:Tr 'Usar carpeta predeterminada'}" Click="ResetReceiveFolder" Padding="10,6" FontSize="12"/></StackPanel></Grid></Border>
          <TextBlock Text="{local:Tr 'Transferencias de esta sesión'}" Style="{StaticResource SectionTitle}"/><Border x:Name="NoFiles" Style="{StaticResource Card}" Margin="0,8,0,0"><StackPanel><TextBlock Text="{local:Tr 'Todavía no hay transferencias'}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{local:Tr 'Los archivos que envíes y las solicitudes que recibas aparecerán aquí.'}" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel></Border>
          <ItemsControl x:Name="TransferList"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource Card}" Padding="20" Margin="0,8,0,4"><StackPanel><TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{local:LiveText Path=Direction}" Style="{StaticResource Caption}" Margin="0,4,0,0"/><ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="5" Margin="0,14,0,10" Background="{DynamicResource CanvasBrush}" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="{Binding Size}" Style="{StaticResource Caption}"/><TextBlock Text="{local:LiveText Path=Detail}" Margin="0,5,0,0"/><WrapPanel Margin="0,12,0,0"><StackPanel Orientation="Horizontal" Visibility="{Binding Acceptance}"><Button Content="{local:Tr 'Aceptar archivo'}" Click="AcceptFile" Tag="{Binding Id}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button Content="{local:Tr 'Rechazar'}" Click="RejectFile" Tag="{Binding Id}" Margin="0,0,8,0"/></StackPanel><Button Content="{local:Tr 'Cancelar'}" Click="CancelFile" Tag="{Binding Id}" Visibility="{Binding Cancellation}"/></WrapPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
        <StackPanel x:Name="SettingsPage" Visibility="Collapsed"><TextBlock Text="{local:Tr 'Preferencias'}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{local:Tr 'Ajusta cómo se conectan y trabajan tus equipos.'}" Style="{StaticResource Caption}" Margin="0,8,0,24"/>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{local:Tr 'Apariencia y ventana'}" Style="{StaticResource SectionTitle}"/><Label Content="{local:Tr 'Idioma de la aplicación'}" Target="{Binding ElementName=LanguageChoice}" Padding="0,0,0,6"/><ComboBox x:Name="LanguageChoice" SelectedValuePath="Tag" Width="230" HorizontalAlignment="Left" SelectionChanged="LanguageChanged" AutomationProperties.Name="{local:Tr 'Idioma de la aplicación'}"><ComboBoxItem Content="Español" Tag="es"/><ComboBoxItem Content="English" Tag="en"/></ComboBox><TextBlock Text="{local:Tr 'Cambiar el idioma no cambia los nombres de tus equipos ni los archivos.'}" Style="{StaticResource Caption}" Margin="0,8,0,16"/><Label Content="{local:Tr 'Tema'}" Target="{Binding ElementName=ThemeChoice}" Padding="0,0,0,6"/><ComboBox x:Name="ThemeChoice" Width="230" HorizontalAlignment="Left" SelectionChanged="ThemeChanged" AutomationProperties.Name="{local:Tr 'Tema de BorderLess'}"><ComboBoxItem Content="{local:Tr 'Claro'}"/><ComboBoxItem Content="{local:Tr 'Oscuro'}"/></ComboBox><TextBlock Text="{local:Tr 'La X y minimizar mantienen BorderLess activo en la bandeja de Windows. Abre su icono para volver; usa Salir para detenerlo por completo.'}" Style="{StaticResource Caption}" Margin="0,16,0,16"/><Button Content="{local:Tr 'Salir de BorderLess'}" HorizontalAlignment="Left" Click="ExitFromSettings"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{local:Tr 'Pausa y bloqueo de Windows'}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{local:Tr 'Pausar suspende el control remoto, el portapapeles y los archivos en este PC, conservando los vínculos. Reanudar los habilita otra vez. Una transferencia cancelada debe enviarse de nuevo.'}" Style="{StaticResource Caption}" Margin="0,0,0,12"/><CheckBox x:Name="PauseWhenLocked" Content="{local:Tr 'Pausar el uso compartido al bloquear Windows'}" Checked="PreferenceChanged" Unchecked="PreferenceChanged"/><TextBlock Text="{local:Tr 'Activada: pausa al bloquear y se reanuda al desbloquear, salvo que hubieras pausado manualmente. Desactivada: la app mantiene sus servicios activos.'}" Style="{StaticResource Caption}" Margin="32,6,0,0"/><TextBlock Text="{local:Tr 'Afecta solo a este PC. Windows sigue protegiendo la pantalla de bloqueo: desde ella BorderLess no captura ni controla los periféricos. Al bloquear siempre se libera el control remoto y se revoca el PIN pendiente.'}" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{local:Tr 'Entrada y portapapeles'}" Style="{StaticResource SectionTitle}"/><CheckBox x:Name="AllowControl" Content="{local:Tr 'Permitir que los equipos vinculados controlen este PC'}" Checked="PreferenceChanged" Unchecked="PreferenceChanged"/><CheckBox x:Name="AutoEdges" Content="{local:Tr 'Cambiar de equipo al cruzar un borde'}" Checked="PreferenceChanged" Unchecked="PreferenceChanged"/><CheckBox x:Name="PointerFallback" Content="{local:Tr 'Mostrar puntero auxiliar cuando Windows lo oculta'}" Checked="PreferenceChanged" Unchecked="PreferenceChanged"/><CheckBox x:Name="ShareText" Content="{local:Tr 'Compartir texto del portapapeles (hasta 1 MB)'}" Checked="PreferenceChanged" Unchecked="PreferenceChanged"/><CheckBox x:Name="ShareImages" Content="{local:Tr 'Compartir imágenes del portapapeles (hasta 8 MB / 16 MP)'}" Checked="PreferenceChanged" Unchecked="PreferenceChanged"/><TextBlock Text="{local:Tr 'Los equipos vinculados pueden recibir lo que copies. Pausa BorderLess para detener entrada, portapapeles y archivos.'}" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,16"><StackPanel><TextBlock Text="{local:Tr 'Conexión'}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{local:Tr 'La reconexión es automática para las conexiones iniciadas desde este PC. Si la dirección del receptor cambia, genera un código nuevo. No necesitas una cuenta para usar la red local.'}" Style="{StaticResource Caption}"/><TextBlock Text="{local:Tr 'Para controlar una aplicación ejecutada como administrador, abre BorderLess como administrador en el PC receptor. La pantalla de bloqueo y el escritorio seguro de UAC no están incluidos.'}" Style="{StaticResource Caption}" Margin="0,12,0,0"/><TextBlock Text="{local:Tr 'Desactiva Mouse sin bordes de PowerToys antes de controlar otro equipo para evitar que ambas aplicaciones capturen la misma entrada.'}" Foreground="{DynamicResource WarningBrush}" Margin="0,12,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="{local:Tr 'Internet mediante relay propio'}" Style="{StaticResource SectionTitle}"/><TextBlock Text="{local:Tr 'Usa conexión directa por VPN o configura un relay BorderLess accesible desde ambos equipos. El contenido viaja cifrado entre tus PCs. La aplicación no incluye un servidor público.'}" Style="{StaticResource Caption}" Margin="0,0,0,16"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><Label Content="{local:Tr 'Dirección del relay'}" Target="{Binding ElementName=RelayHost}" Padding="0,0,0,6"/><TextBox x:Name="RelayHost" AutomationProperties.Name="{local:Tr 'Dirección del relay'}"/></StackPanel><StackPanel Grid.Column="1"><Label Content="{local:Tr 'Puerto'}" Target="{Binding ElementName=RelayPort}" Padding="0,0,0,6"/><TextBox x:Name="RelayPort" Text="45162"/></StackPanel></Grid><StackPanel Orientation="Horizontal" Margin="0,16,0,0"><Button Content="{local:Tr 'Activar relay'}" Click="EnableRelay" Margin="0,0,12,0"/><Button Content="{local:Tr 'Desactivar'}" Click="DisableRelay"/></StackPanel><TextBlock x:Name="RelayStatus" Text="{local:Tr 'Relay desactivado'}" Style="{StaticResource Caption}" Margin="0,12,0,0"/></StackPanel></Border>
        </StackPanel>
        <StackPanel x:Name="ActivityPage" Visibility="Collapsed"><Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{local:Tr 'Actividad'}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{local:Tr 'Conexión y recuperación, sin guardar lo que escribes o copias.'}" Style="{StaticResource Caption}" Margin="0,8,0,0"/></StackPanel><Button Grid.Column="1" Content="{local:Tr 'Exportar diagnóstico'}" Click="ExportDiagnostics" VerticalAlignment="Center"/></Grid><Border Style="{StaticResource Card}" Padding="20"><ItemsControl x:Name="ActivityList"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Time, StringFormat=HH:mm:ss}" FontFamily="Consolas" Foreground="{DynamicResource MutedBrush}" FontSize="12"/><TextBlock Grid.Column="1" Text="{local:LiveText Path=Message}" LineHeight="21"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border></StackPanel>
      </Grid></ScrollViewer>
      <Border x:Name="PauseNotice" Grid.Row="1" Visibility="Collapsed" Background="{DynamicResource WarningSurfaceBrush}" Padding="24,12"><TextBlock x:Name="PauseNoticeText" Foreground="{DynamicResource WarningBrush}" FontSize="13" LineHeight="20"/></Border>
      <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="ControlStatus" Text="{local:Tr 'El control está en este equipo'}" FontWeight="SemiBold"/><TextBlock x:Name="NetworkStatus" Text="{local:Tr 'TLS · conexión directa · esperando equipos'}" Style="{StaticResource Caption}" FontSize="12" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="{local:Tr 'Volver aquí'}" Click="ReturnLocal" Margin="12,0" VerticalAlignment="Center"/><Button x:Name="PauseButton" Grid.Column="2" Content="{local:Tr 'Pausar uso compartido'}" Click="TogglePause" VerticalAlignment="Center"/></Grid></Border>
    </Grid>
    <Grid x:Name="PairOverlay" Grid.ColumnSpan="2" Visibility="Collapsed" Background="#660E2520"><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Width="690" MaxHeight="730" Margin="24" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{local:Tr 'Añadir un equipo'}" FontSize="25" FontWeight="SemiBold"/><Button Grid.Column="1" Content="{local:Tr 'Cerrar'}" Click="ClosePairing" Padding="12,6"/></Grid>
      <TextBlock Text="{local:Tr 'Vincula tus PCs con 8 dígitos. Actualiza ambos equipos para conectar sin confirmación adicional.'}" Style="{StaticResource Caption}" Margin="0,10,0,18"/>
      <TabControl x:Name="PairTabs" Background="{DynamicResource SurfaceBrush}" BorderThickness="0" Padding="0,14,0,0" SelectionChanged="PairTabChanged">
        <TabItem Header="{local:Tr 'Conectar a otro PC'}"><StackPanel Margin="0,10,0,0">
          <TextBlock Text="{local:Tr 'En el otro PC, abre Recibir en este PC y genera un código. Después selecciónalo aquí o escribe su dirección.'}" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
          <Label Content="{local:Tr 'Equipos que esperan vinculación'}" Target="{Binding ElementName=DiscoveredPeers}" Padding="0,0,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="DiscoveredPeers" DisplayMemberPath="Label" SelectionChanged="DiscoveredPeerSelected" AutomationProperties.Name="{local:Tr 'Equipo encontrado en red local'}"/><Button x:Name="SearchPeersButton" Grid.Column="1" Content="{local:Tr 'Buscar equipos'}" Click="SearchPeers" Margin="10,0,0,0"/></Grid>
          <TextBlock x:Name="DiscoveryStatus" Text="{local:Tr 'La búsqueda solo se ejecuta mientras utilizas este panel.'}" Style="{StaticResource Caption}" Margin="0,6,0,12"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,10,0"><Label Content="{local:Tr 'Dirección del otro PC (IP o nombre)'}" Target="{Binding ElementName=PinHost}" Padding="0,0,0,6"/><TextBox x:Name="PinHost" AutomationProperties.Name="{local:Tr 'Dirección del PC para vincular con PIN'}"/></StackPanel><StackPanel Grid.Column="1"><Label Content="{local:Tr 'Puerto'}" Target="{Binding ElementName=PinPort}" Padding="0,0,0,6"/><TextBox x:Name="PinPort" Text="45161" MaxLength="5" AutomationProperties.Name="{local:Tr 'Puerto del PC para vincular con PIN'}"/></StackPanel></Grid>
          <Label Content="{local:Tr 'Código de 8 dígitos del otro PC'}" Target="{Binding ElementName=PinInput}" Padding="0,14,0,6"/><TextBox x:Name="PinInput" FontFamily="Consolas" FontSize="25" MaxLength="9" MinHeight="52" AutomationProperties.Name="{local:Tr 'Código temporal de 8 dígitos'}"/>
          <TextBlock Text="{local:Tr 'El PIN correcto autoriza el vínculo automáticamente. Compártelo solo con tu otro PC.'}" Style="{StaticResource Caption}" Margin="0,12,0,16"/><Button x:Name="PinConnectButton" Content="{local:Tr 'Vincular con PIN'}" Click="ConnectWithPin" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/>
        </StackPanel></TabItem>
        <TabItem Header="{local:Tr 'Recibir en este PC'}"><StackPanel Margin="0,10,0,0">
          <TextBlock Text="{local:Tr 'Generar el código permite vincular a quien lo conozca durante 2 minutos. Escríbelo en tu otro PC; no tendrás que volver a confirmar aquí.'}" Style="{StaticResource Caption}"/>
          <TextBlock x:Name="PairLocalAddress" FontWeight="SemiBold" Margin="0,12,0,12"/>
          <Button x:Name="GeneratePinButton" Content="{local:Tr 'Generar código de 8 dígitos'}" Click="GeneratePin" HorizontalAlignment="Left"/>
          <TextBox x:Name="PinOutput" IsReadOnly="True" Text="{local:Tr 'Sin código activo'}" FontFamily="Consolas" FontSize="30" TextAlignment="Center" MinHeight="65" Margin="0,14,0,8" AutomationProperties.Name="{local:Tr 'Código corto de este PC'}"/>
          <TextBlock x:Name="PinExpiry" Text="{local:Tr 'Vigencia de 2 minutos · un solo uso · hasta 5 intentos'}" Style="{StaticResource Caption}"/>
          <Button Content="{local:Tr 'Revocar código'}" Click="RevokePin" HorizontalAlignment="Left" Margin="0,12,0,0"/>
        </StackPanel></TabItem>
        <TabItem Header="{local:Tr 'Avanzado'}"><StackPanel Margin="0,10,0,0">
          <TextBlock Text="{local:Tr 'Código largo para relay de internet o versiones anteriores. Contiene una clave temporal: transfiérelo por un medio privado.'}" Style="{StaticResource Caption}" Margin="0,0,0,12"/>
          <Expander Header="{local:Tr 'Conectar con código largo'}" IsExpanded="True" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="0,12,0,12"><Label Content="{local:Tr 'Código generado en el otro equipo'}" Target="{Binding ElementName=InviteInput}" Padding="0,0,0,6"/><TextBox x:Name="InviteInput" AcceptsReturn="False" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" AutomationProperties.Name="{local:Tr 'Código de vinculación largo'}"/><Label Content="{local:Tr 'Dirección alternativa (opcional, por ejemplo IP de VPN)'}" Target="{Binding ElementName=HostOverride}" Padding="0,12,0,6"/><TextBox x:Name="HostOverride"/><Button x:Name="ConnectButton" Content="{local:Tr 'Vincular y conectar'}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Click="ConnectPeer" Margin="0,12,0,0"/></StackPanel></Expander>
          <Expander Header="{local:Tr 'Generar código largo'}" Foreground="{DynamicResource TextBrush}"><StackPanel Margin="0,12,0,0"><CheckBox x:Name="InviteViaRelay" Content="{local:Tr 'Usar el relay de internet configurado'}"/><Button Content="{local:Tr 'Generar código largo temporal'}" Click="GenerateInvite" HorizontalAlignment="Left"/><TextBox x:Name="InviteOutput" IsReadOnly="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Margin="0,12,0,12" AutomationProperties.Name="{local:Tr 'Código largo temporal de este equipo'}"/><WrapPanel><Button x:Name="CopyCodeButton" Content="{local:Tr 'Copiar código'}" IsEnabled="False" Click="CopyInvite" Margin="0,0,10,0"/><Button Content="{local:Tr 'Revocar código largo'}" Click="RevokeInvite"/></WrapPanel><TextBlock x:Name="InviteExpiry" Style="{StaticResource Caption}" Margin="0,10,0,0"/></StackPanel></Expander>
        </StackPanel></TabItem>
      </TabControl>
      <Border x:Name="PairFeedbackBox" Visibility="Collapsed" Background="{DynamicResource WarningSurfaceBrush}" CornerRadius="7" Padding="14" Margin="0,16,0,0"><TextBlock x:Name="PairFeedback" Foreground="{DynamicResource WarningBrush}" LineHeight="21"/></Border>
    </StackPanel></ScrollViewer></Border></Grid>
    <Grid x:Name="AliasOverlay" Grid.ColumnSpan="2" Background="#660E2520" Visibility="Collapsed"><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Width="510" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel>
      <TextBlock Text="{local:Tr 'Nombre del equipo'}" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="AliasMachine" Style="{StaticResource Caption}" Margin="0,10,0,18"/>
      <Label Content="{local:Tr 'Alias para mostrar'}" Target="{Binding ElementName=AliasInput}" Padding="0,0,0,6"/><TextBox x:Name="AliasInput" MaxLength="40" AutomationProperties.Name="{local:Tr 'Alias del equipo'}"/>
      <TextBlock Text="{local:Tr 'Hasta 40 caracteres. Déjalo vacío para usar el nombre original. No cambia la identidad ni las claves.'}" Style="{StaticResource Caption}" Margin="0,10,0,0"/><TextBlock x:Name="AliasError" Foreground="{DynamicResource ErrorBrush}" Margin="0,10,0,0"/>
      <WrapPanel HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="{local:Tr 'Usar nombre original'}" Click="ResetAlias" Margin="0,0,8,0"/><Button Content="{local:Tr 'Cancelar'}" Click="CloseAlias" Margin="0,0,8,0"/><Button Content="{local:Tr 'Guardar alias'}" Style="{StaticResource PrimaryButton}" Click="SaveAlias" IsDefault="True"/></WrapPanel>
    </StackPanel></Border></Grid>
  </Grid>
</Window>


